# macOS
.DS_Store
.fuse_hidden*

# Obsidian local data (plugins may contain API keys)
.obsidian/

# Smart Connections plugin (local embeddings, large binary data)
.smart-env/

# Claude Code local settings (contains API tokens)
.claude/

# Other AI tool local config (same rationale — may contain tokens/settings)
.agents/
.copilot/
.opencode/
copilot/

# Python bytecode
__pycache__/
*.pyc

# Dance material recordings — canonical location is OUTSIDE the vault
# (~/Library/Mobile Documents/com~apple~CloudDocs/Dance_Material/).
# This is a safety net in case a file lands here by accident: video must never
# enter the repo. Note it does NOT stop iCloud from syncing — that is why the
# real location is outside the vault.
Dance_Material/
*.mov
*.mp4
*.MOV
*.MP4

# Sensitive credentials
*.pickle
*.google_token*
google_oauth_credentials.json
*credentials*.json
*client_secret*.json
.google_oauth_credentials.json
scripts/.google_token.pickle

# Logs
*.log
